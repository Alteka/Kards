# Without this, `npm run lint` walks build output and vendored bundles and
# rewrites them, because the script runs `eslint . --fix`. That made the lint
# script actively unsafe to run — see docs/review/09-kickoff.md, Traps.

node_modules
dist
dist_electron

# Vendored, minified, not ours to reformat.
*.min.js

# Generated by the pixel harness. Prettier ignores it for the same reason.
test/pixel/baseline.json

{
  "name": "kards",
  "version": "1.3.1",
  "description": "A cross-platform test card generator for AV professionals",
  "author": "Alteka Solutions <info@alteka.solutions>",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix",
    "format": "prettier --write \"src/**/*.{vue,js,jsx,cjs,mjs,json}\" \"*.{json,md}\"",
    "electron:serve": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:matt": "vite build && electron-builder --mac --x64",
    "electron:build:universal": "vite build && electron-builder --universal",
    "release:mac": "node scripts/mac/release.js",
    "release:mac:verify": "node scripts/mac/verify.js",
    "_comment_pixel": "Each of these rebuilds first on purpose: the harness loads dist/, and a stale dist silently tests the previous commit's code.",
    "test:pixel": "vite build && node test/pixel/run.js",
    "test:pixel:validate": "vite build && node test/pixel/run.js --validate",
    "test:pixel:record": "vite build && node test/pixel/run.js --record",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps"
  },
  "main": "src/background.js",
  "dependencies": {
    "@electron/universal": "^1.2.1",
    "@fortawesome/fontawesome-free": "^6.1.1",
    "axios": "0.27.2",
    "body-parser": "^1.19.1",
    "bonjour": "^3.5.0",
    "compare-versions": "^4.1.3",
    "core-js": "^3.6.5",
    "dom-to-image": "^2.6.0",
    "electron-log": "^4.4.4",
    "electron-store": "^8.0.1",
    "element-plus": "1.0.2-beta.71",
    "express": "^4.17.2",
    "mime-types": "^2.1.34",
    "mousetrap": "^1.6.5",
    "osc-js": "^2.3.1",
    "rollbar": "^2.24.0",
    "say": "^0.16.0",
    "uuid": "^8.3.2",
    "vue": "^3.0.0",
    "vue-router": "^4.0.0-0",
    "vue3-resize": "^0.2.0",
    "vue3-resize-text": "^0.1.0",
    "wallpaper": "5.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^24.0.0",
    "electron-devtools-installer": "^3.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^3.8.1",
    "sass": "^1.49.11",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "productName": "Kards",
    "appId": "solutions.alteka.kards",
    "files": [
      "dist/**",
      "src/**",
      "package.json"
    ],
    "directories": {
      "output": "dist_electron"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "_comment_asarUnpack": "wallpaper ships Mach-O/PE binaries it execFile()s. Electron can run them from inside an asar (it extracts to temp first), but codesign cannot sign them there, and an unsigned executable in the bundle fails Apple notarisation.",
    "asarUnpack": [
      "node_modules/wallpaper/source/**"
    ],
    "afterSign": "scripts/mac/after-sign.js",
    "mac": {
      "icon": "public/icon.png",
      "target": "pkg",
      "_comment_identity": "NEVER null and never absent. Auto-selection from the keychain is what silently picked an Apple Development certificate from 2022 to 2024. scripts/mac/preflight.js refuses to build unless this starts with 'Developer ID Application:'. Replace the placeholder with the exact string from `security find-identity -v -p codesigning`.",
      "identity": "Developer ID Application: REPLACE ME (D4H96T8MEW)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "_comment_notarize": "false on purpose. Notarisation is done by scripts/mac/after-sign.js so the .app can be STAPLED before it is packaged, which electron-builder's own notarize step does not do. See scripts/mac/notary.js.",
      "notarize": false,
      "_comment_minimumSystemVersion": "Electron 34's real floor. D6 (Electron 43) raises this to 12.0 and that drops Big Sur users - it belongs in the release notes, not in a diff.",
      "minimumSystemVersion": "11.0"
    },
    "pkg": {
      "_comment_identity": "A Developer ID *Installer* certificate - a different certificate from the Application one. Kards has never had one, which is why no published .pkg has ever been signed. From `security find-identity -v`.",
      "identity": "Developer ID Installer: REPLACE ME (D4H96T8MEW)"
    },
    "win": {
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": false,
      "menuCategory": true
    }
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2022": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:vue/vue3-recommended",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "homepage": "http://www.alteka.solutions",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alteka/Kards"
  },
  "volta": {
    "node": "22.22.0"
  }
}

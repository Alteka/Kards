{
  "name": "kards",
  "version": "1.3.1",
  "description": "A cross-platform test card generator for AV professionals",
  "author": "Alteka Solutions <info@alteka.solutions>",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac --universal",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/typed-ipc": "^1.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fortawesome/fontawesome-free": "^6.1.1",
    "@tsparticles/vue3": "^3.0.1",
    "axios": "^1.9.0",
    "body-parser": "^1.19.1",
    "bonjour-service": "^1.3.0",
    "compare-versions": "^6.1.1",
    "defu": "^6.1.4",
    "dom-to-image": "^2.6.0",
    "electron-log": "^5.4.0",
    "electron-store": "^8.2.0",
    "element-plus": "^2.9.10",
    "express": "^4.17.2",
    "mime-types": "^3.0.1",
    "mousetrap": "^1.6.5",
    "osc-js": "^2.4.1",
    "prettier": "^3.5.3",
    "rollbar": "^2.24.0",
    "say": "^0.16.0",
    "tsparticles": "^3.8.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vue3-resize": "^0.2.0",
    "vue3-resize-text": "^0.1.0",
    "wallpaper": "^5.0.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/express": "4",
    "@types/mime-types": "^2.1.4",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^22.15.18",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.26.0",
    "eslint-plugin-vue": "^10.1.0",
    "sass": "^1.88.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.6",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.10"
  },
  "homepage": "http://www.alteka.solutions",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alteka/Kards"
  },
  "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72"
}
